* root kasutajana:
 install: apt-get intall git (või sudo kui on, ei pea logima eraldi rooti)
 kontrol: which git

* tava kasutaja:

 kaust: mkdir skriptimine
          cd skriptimine

 config: git config --global user.name "sven-erikarro-design"
         git config --global user.email sven-erik.arro@voco.ee
         git config --global core.editor nano
         
 jälgimine: git init

 remote: git remote add {nimi} github@github.com:sven-erikarro-design{reponimi}.git
 remote kontroll: git remote -v
 
 commit uuendused: git add {file}
                   git commit -m "{commit komentaar]"
                   git push -uf {repo} {branch} 
